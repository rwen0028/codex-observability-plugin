{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/index.mjs\"",
            "timeout": 30,
            "statusMessage": "Uploading Codex trace to Langfuse",
            "commandWindows": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT,'dist','index.mjs')).href)\""
          }
        ]
      }
    ]
  }
}
